# Kept out of the build context: faster builds, and no secrets baked into an image.

# Host venv (macOS binaries) and git history.
.venv
.git

# Secrets; the template stays allowed.
.env
.env.*
!.env.example

# Test and coverage output.
htmlcov
.coverage
.coverage.*
.pytest_cache
__pycache__
**/__pycache__

# Editor and Claude Code config, personal notes.
.claude
.vscode
*.local.md
