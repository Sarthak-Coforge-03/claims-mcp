# Copy to .env and adjust as needed. .env is gitignored; never commit real values.
# All settings are optional; the defaults below are used when a variable is unset.

# Backend data files (paths relative to the working directory: repo root, or /app in Docker)
CLAIMS_MCP_EMPLOYEES_FILE=data/employees.json
CLAIMS_MCP_POLICIES_FILE=data/policies.json
# Written by flag_for_human_review; created on the first escalation (gitignored)
CLAIMS_MCP_ESCALATIONS_FILE=data/escalations.json

# MCP server over Streamable HTTP (compose sets HOST=0.0.0.0 and the dev URL to mcp_server)
CLAIMS_MCP_SERVER_HOST=127.0.0.1
CLAIMS_MCP_SERVER_PORT=8000
# Where clients connect (smoke client, later the host agent)
CLAIMS_MCP_SERVER_URL=http://localhost:8000/mcp

# Host / agent (needed later, when the LangGraph agent lands)
# ANTHROPIC_API_KEY=your-key-here
